# Gmail – preferred (from https://myaccount.google.com/apppasswords)
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Where form submissions are sent (optional; defaults to GMAIL_USER)
NOTIFY_EMAIL=yourgmail@gmail.com

# Legacy fallbacks (still supported)
# EMAIL_USER=yourgmail@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_TO=yourgmail@gmail.com

# Server port
PORT=5000

# Optional: CORS origin (comma-separated for multiple)
# CORS_ORIGIN=http://localhost:5500,http://yoursite.com
